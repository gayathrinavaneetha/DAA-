from daa_utils import optimal_bst

def print_obst(cost, root):
    n = len(cost)
    print("Cost Matrix:")
    for row in cost:
        print("\t".join(map(str, row)))
    print("\nRoot Matrix:")
    for row in root:
        print("\t".join(map(str, row)))
keys = [10, 12, 16, 21]
freq = [4, 2, 6, 3]
cost, root = optimal_bst(keys, freq)
print_obst(cost, root)
print("Optimal Cost:", cost[0][len(keys) - 1])
